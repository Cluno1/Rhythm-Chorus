<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher picker preview for the Rhythm Lyrics widget.
     Uses only framework-safe views with margins/gravity (no Space, weights,
     or ellipsize) so launchers can inflate it reliably. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="250dp"
    android:layout_height="150dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_preview_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Brand row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_notification"
                app:tint="@color/widget_preview_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rhythm"
                android:textColor="@color/widget_preview_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Midnight Drive"
            android:textColor="@color/widget_preview_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Neon Waves"
            android:textColor="@color/widget_preview_subtext"
            android:textSize="12sp"
            android:layout_marginTop="1dp" />

        <!-- Active lyric line (highlighted) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forever running through the night"
            android:textColor="@color/widget_preview_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <!-- Next lyric line (dim) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="With every heartbeat close to you"
            android:textColor="@color/widget_preview_surface_variant"
            android:textSize="12sp"
            android:layout_marginTop="1dp" />

        <!-- Controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="8dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_circle"
                    app:tint="@color/widget_preview_tertiary" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/widget_preview_on_tertiary" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_pill"
                    app:tint="@color/widget_preview_primary" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="@color/widget_preview_on_primary" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_circle"
                    app:tint="@color/widget_preview_tertiary" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/widget_preview_on_tertiary" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
