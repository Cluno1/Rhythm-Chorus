<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher picker preview for the Rhythm Music widget.
     Uses only framework-safe views with margins/gravity (no Space, weights,
     or ellipsize) so launchers can inflate it reliably. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="250dp"
    android:layout_height="140dp">

    <ImageView
        android:importantForAccessibility="no"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_preview_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_art" />

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/widget_preview_on_primary_container" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_title"
                    android:textColor="@color/widget_preview_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_subtitle"
                    android:textColor="@color/widget_preview_subtext"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_circle"
                    app:tint="@color/widget_preview_tertiary" />

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/widget_preview_on_tertiary" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="14dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_pill"
                    app:tint="@color/widget_preview_primary" />

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="@color/widget_preview_on_primary" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="14dp">

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_preview_circle"
                    app:tint="@color/widget_preview_tertiary" />

                <ImageView
        android:importantForAccessibility="no"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/widget_preview_on_tertiary" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
